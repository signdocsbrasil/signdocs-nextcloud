{
    "name": "signdocs-brasil/signdocs-nextcloud",
    "description": "Nextcloud app for SignDocs Brasil — sign documents from the Files app with ICP-Brasil or electronic signatures",
    "type": "nextcloud-app",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "SignDocs Brasil",
            "email": "dev@signdocs.com.br",
            "homepage": "https://signdocs.com.br"
        }
    ],
    "require": {
        "php": "^8.1",
        "signdocs-brasil/signdocs-brasil-php": "^1.4"
    },
    "require-dev": {
        "doctrine/dbal": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.65",
        "nextcloud/coding-standard": "^1.3",
        "nextcloud/ocp": "dev-master",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\SignDocsBrasil\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\SignDocsBrasil\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "test": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration"
    },
    "config": {
        "vendor-dir": "composer",
        "sort-packages": true,
        "audit": {
            "abandoned": "report",
            "block-insecure": false
        }
    }
}
