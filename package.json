{
  "name": "signdocs-nextcloud",
  "version": "0.1.0",
  "private": true,
  "description": "Source bundle for the SignDocs Brasil Nextcloud app's file action",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "npm run build:action && npm run build:landing",
    "build:action": "esbuild src/files-action.js --bundle --minify --target=es2020 --format=iife --platform=browser --outfile=js/signdocs-files-action.js",
    "build:landing": "esbuild src/landing-page.js --bundle --minify --target=es2020 --format=iife --platform=browser --outfile=js/signdocs-landing-page.js",
    "watch": "esbuild src/files-action.js src/landing-page.js --bundle --target=es2020 --format=iife --platform=browser --outdir=js --watch"
  },
  "dependencies": {
    "@nextcloud/files": "^3.10.0",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.1.0",
    "@nextcloud/router": "^3.0.1"
  },
  "devDependencies": {
    "buffer": "^6.0.3",
    "esbuild": "^0.24.0",
    "string_decoder": "^1.3.0"
  }
}
